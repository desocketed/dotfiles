;;; $DOOMDIR/keybinds.el -*- lexical-binding: t; -*-

(map! :leader "h ." #'helpful-at-point :after helpful :desc "Helpful at point")
(map! :leader "s r" #'consult-ripgrep :after consult :desc "ripgrep")
(map! :leader "p" #'treebundel :after treebundel :desc "Treebundel")
(map! :leader "c h" #'eglot-momentary-inlay-hints :after eglot :desc "Inlay Hints")
(map! :v "v" #'er/expand-region :after expand-region)
(map! :g "C-." #'embark-act :after embark :desc "Act")
(map! :n "G" #'end-of-buffer :desc "End of buffer")

(after! lispy
  (unbind-key "<backtab>" 'lispy-mode-map)
  (unbind-key "<backtab>" 'lispy-mode-map-lispy)
  (unbind-key "[" 'lispy-mode-map)
  (unbind-key "[" 'lispy-mode-map-lispy)
  (unbind-key "]" 'lispy-mode-map)
  (unbind-key "]" 'lispy-mode-map-lispy))
(after! lispyville
  (unbind-key "<normal-state> M-a" 'lispyville-mode-map))

(unbind-key "TAB l" 'doom-leader-map)
(map! :leader "TAB h" #'+workspace:switch-previous)
(map! :leader "TAB l" #'+workspace:switch-next)

(defun yank-whole-buffer ()
  (interactive)
  (save-excursion
    (evil-yank (point-min) (point-max)))
  (message "Yanked whole buffer"))
(map! :leader "y" #'yank-whole-buffer)

